          <!-- Lista -->
          <ScrollViewer x:Name="Scroll" MaxHeight="520" Margin="0,10,0,0"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <StackPanel x:Name="List"/>
