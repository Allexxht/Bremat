function AskText($q, $def = '') {
  Add-Type -AssemblyName Microsoft.VisualBasic
  $script:modal = $true
  try { ([Microsoft.VisualBasic.Interaction]::InputBox($q, 'Teendőim', $def) -replace '\s+', ' ').Trim() } finally { $script:modal = $false }
}
function ActAdd {
  $t = AskText 'Az új tevékenység-gomb neve (pl. E-mail, DPTS programozás, Megbeszélés):'
  if (-not $t) { return }
  if ($t.Length -gt 60) { $t = $t.Substring(0, 60) }
  $it = Norm @{ text = $t; kind = 'act'; order = (OrderEdge $true) }
  [void]$script:items.Add($it); Commit
}
function ActRename($id) {
  $it = FindItem $id; if (-not $it) { return }
  $t = AskText 'A tevékenység új neve:' $it.text
  if ($t -and $t -ne $it.text) { $it.text = $t.Substring(0, [Math]::Min(60, $t.Length)); Commit }
}
function ActDelete($id) {
  $it = FindItem $id; if (-not $it) { return }
  $script:modal = $true
  try { $ans = [System.Windows.MessageBox]::Show($win, ('Törlöd a(z) „' + $it.text + '” gombot?' + "`n`n" + 'A naplóban az eddig mért ideje megmarad.'), 'Teendőim', 'YesNo') } finally { $script:modal = $false }
  if ($ans -ne 'Yes') { return }
  if ($it.state -eq 'doing') { StopRun $it; $it.state = 'open' }
  RemoveItem $id; Commit
}

function Render {
  $U.List.Children.Clear(); $U.DoneList.Children.Clear(); $script:live = @()
  $active = @($script:items | Where-Object { $_.state -eq 'open' -and -not (IsAct $_) } | Sort-Object @{ Expression = { $_.order } }, @{ Expression = { $_.created } })
  $doneI  = @($script:items | Where-Object { $_.state -eq 'done' } | Sort-Object @{ Expression = { $_.doneAt } } -Descending)
  foreach ($it in $active) { [void]$U.List.Children.Add((Row $it)) }
  if ($script:set.showDone) { foreach ($it in $doneI) { [void]$U.DoneList.Children.Add((Row $it)) } }
  $script:fresh = @(); $script:spin = $null

  $total = @(Todos).Count; $nd = $doneI.Count; $no = $total - $nd
  RenderActs
  $U.Empty.Visibility = $(if ($active.Count -eq 0 -and $no -eq 0) { 'Visible' } else { 'Collapsed' })
  $U.Empty.Text = $(if ($total -eq 0) { 'Üres a lista. Írd be fent az első teendőt.' } else { 'Nincs hátralévő teendő.' })
  $U.DoneHead.Visibility = $(if ($nd) { 'Visible' } else { 'Collapsed' })
  $sumDone = 0; foreach ($d in $doneI) { $sumDone += [int64]$d.spent }
  $U.DoneHeadText.Text = "Kész ($nd)" + $(if ($sumDone -gt 0) { "  ·  összesen $(FmtDur $sumDone)" } else { '' })
  Anim $U.DoneArrow.RenderTransform $ANG $null $(if ($script:set.showDone) { 90 } else { 0 }) 320
  $U.Count.Text = $(if ($total) { "$no hátra  ·  $nd kész" } else { 'Még nincs teendő' })
  $U.TodayText.Text = 'ma ' + (FmtDur (TodayMs))
  $tw = $(if ($U.Track.ActualWidth -gt 0) { $U.Track.ActualWidth } else { 330 })
  Anim $U.Fill $WP $null $(if ($total) { $tw * $nd / $total } else { 0 }) 900

  $badge = $(if ($total -and -not $no) { '✓' } else { "$no" })
  if ($badge -ne $script:lastBadge) {
    $U.BadgeText.Text = $badge
    if ($script:lastBadge) { Pop $U.Badge.RenderTransform 1.4 400 }
    $script:lastBadge = $badge
  }
  $all = $total -gt 0 -and $no -eq 0
  if ($all -and $U.Cheer.Visibility -ne 'Visible') { $U.Cheer.Visibility = 'Visible'; Pop $U.Cheer.RenderTransform 0.5 500 }
  if (-not $all) { $U.Cheer.Visibility = 'Collapsed' }
  RenderRun
}
function Commit {
  SaveData; Render
  if ($script:focusNotes) {
    foreach ($k in $U.List.Children) { if ($k.Tag -eq $script:focusNotes) { Later 200 $k.DataContext.box { param($b) [void]$b.Focus() } } }
    $script:focusNotes = $null
  }
}

# Másodpercenként: futó óra frissítése; alvás után nem számolja az alvás idejét
$script:lastTick = NowMs; $script:lastSeenSave = 0
function Tick {
  $now = NowMs
  $prev = $script:lastTick
  $gap = $now - $prev
  $script:lastTick = $now
  $runs = @(RunningAll)
  if ($gap -gt 120000 -and $runs.Count) {
    # alvás / hibernálás: az alvás ideje nem számít, a szakasz ott megszakad
    foreach ($r in $runs) { if ($r.startedAt) { $r.startedAt = [int64]$r.startedAt + ($gap - 1000); SegClose $r $prev; SegOpen $r $now } }
    SaveData
  }
  foreach ($p in $script:actLive) { $r = FindItem $p[0]; if ($r -and $r.state -eq 'doing') { $ms = SegToday $r.id; if ($ms -ge 60000) { $p[1].Text = FmtDur $ms } } }
  foreach ($p in $script:live) { $r = FindItem $p[0]; if ($r -and $r.state -eq 'doing') { $p[1].Text = FmtLive (Elapsed $r) } }
  if ($runs.Count) { $U.TabTimerText.Text = TabText $runs }
  if ($runs.Count -or $gap -gt 60000) { $U.TodayText.Text = 'ma ' + (FmtDur (TodayMs)) }
  if ($script:dirty -and -not $script:drag) { SaveData; $script:dirty = $false }
  if ($script:idleOk -and [int]$script:set.idleMin -gt 0) {
    $idle = [TeendoimIdle]::IdleMs()
    # szünet közben nem kérdez – akkor épp az a cél, hogy ne nyúlj a géphez
    $work = @($runs | Where-Object { $_.kind -ne 'brk' })
    if ($work.Count -and $idle -ge [int]$script:set.idleMin * 60000) { AutoPause ($now - $idle) }
    elseif ($script:away.Count -and -not $script:awayShown -and $idle -lt 3000) { ShowAway }
  }
  if ($now - $script:lastSeenSave -gt 30000) { $script:set.lastSeen = $now; SaveSet; $script:lastSeenSave = $now }
  try { NaploPump } catch { NaploLog "$_" }
  try { UpdPump } catch { UpdLog "$_" }
}

# ---------- Automatikus szünet tétlenségnél ----------
$script:away = @(); $script:awayFrom = $null; $script:awayShown = $false
function AutoPause($cut) {
  foreach ($r in @(RunningAll)) {
    if ($r.kind -eq 'brk') { continue }
    StopRun $r $cut; $r.state = 'open'
    $script:away += $r.id
  }
  if (-not $script:awayFrom) { $script:awayFrom = $cut }
  $script:awayShown = $false
  Commit
}
function ShowAway {
  $script:awayShown = $true
  $mins = [int][Math]::Round(((NowMs) - [int64]$script:awayFrom) / 60000)
  $names = @($script:away | ForEach-Object { $x = FindItem $_; if ($x) { $x.text } })
  if (-not $names.Count) { $script:away = @(); Render; return }
  $at = [DateTimeOffset]::FromUnixTimeMilliseconds([int64]$script:awayFrom).LocalDateTime.ToString('HH:mm')
  $U.AwayTitle.Text = "Szünetet tartottál – $mins percig nem nyúltál a géphez."
