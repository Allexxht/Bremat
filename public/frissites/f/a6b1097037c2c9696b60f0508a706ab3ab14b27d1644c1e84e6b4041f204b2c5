function ResumeAway($count) {
  # Ha nem számolom bele, a távollét szünetként kerül az idősávba
  if (-not $count -and $script:awayFrom) { SegAdd '' 'Szünet' 'break' ([int64]$script:awayFrom) (NowMs) }
