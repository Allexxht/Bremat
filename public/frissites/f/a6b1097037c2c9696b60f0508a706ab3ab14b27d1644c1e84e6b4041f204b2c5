            </Border>
            <Border x:Name="AddBtn" Grid.Column="1" Margin="6,0,0,0" Width="38" CornerRadius="10" Background="{{accent}}"
                    Cursor="Hand" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
              <Path Data="M10,4 V16 M4,10 H16" Stroke="{{accentFg}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
