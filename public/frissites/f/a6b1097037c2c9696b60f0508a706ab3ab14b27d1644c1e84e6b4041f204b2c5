            <TextBlock x:Name="Count" Foreground="{{muted}}" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="TodayText" Grid.Column="1" Foreground="{{muted}}" FontSize="13" FontFamily="{{mono}}"/>
          </Grid>
          <Border x:Name="Track" Height="6" CornerRadius="3" Background="{{line}}">
            <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{{ok}}"/>
          </Border>
          <TextBlock x:Name="Cheer" Text="Minden kész, szép munka!" Foreground="{{ok}}" FontWeight="SemiBold" Margin="2,8,0,0"
                     Visibility="Collapsed" RenderTransformOrigin="0,0.5">
