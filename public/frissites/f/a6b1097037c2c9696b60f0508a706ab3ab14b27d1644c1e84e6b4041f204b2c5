    [void]$g.Children.Add($pb)
  }

  # Rámutatásra: lágy háttér, előjön a fogantyú, a csillag és a kuka
  $row.DataContext = @{ bg = $bgb; grip = $grip; det = $det; title = $tb; chev = $chev; box = $box }
  $row.add_MouseEnter({ param($s, $e)
    $d = $s.DataContext; if ($script:drag) { return }
    Fade $d.bg $C.hover 180
    if ($d.grip.Child) { Anim $d.grip $OP $null 0.55 220 } })
  $row.add_MouseLeave({ param($s, $e)
    $d = $s.DataContext; if ($script:drag) { return }
