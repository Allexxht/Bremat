              <Border x:Name="DoneHead" Background="Transparent" Cursor="Hand" Padding="6,10,6,4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="DoneArrow" Text="▸" Foreground="{{muted}}" Width="10" Margin="0,0,6,0" TextAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock>
                  <TextBlock x:Name="DoneHeadText" Foreground="{{muted}}" FontWeight="SemiBold" FontSize="13"/>
