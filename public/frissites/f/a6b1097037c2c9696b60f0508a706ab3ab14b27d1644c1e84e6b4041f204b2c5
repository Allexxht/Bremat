  foreach ($it in @($script:items | Where-Object { IsAct $_ } | Sort-Object @{ Expression = { if ($_.kind -eq 'brk') { 1 } else { 0 } } }, @{ Expression = { $_.order } }, @{ Expression = { $_.created } })) {
    [void]$U.Acts.Children.Add((ActChip $it))
