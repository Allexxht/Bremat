  }
  $dc = New-Object Windows.Controls.Border; $dc.Style = $win.Resources['Chip']; $dc.Tag = $row
  $ds = New-Object Windows.Controls.StackPanel; $ds.Orientation = 'Horizontal'
  [void]$ds.Children.Add((Icon $ICON.del $null (Brush $C.no) 1.6 14))
  $dt = Txt 'Törlés' 12.5 $C.no 'SemiBold'; $dt.Margin = '5,0,0,0'; [void]$ds.Children.Add($dt)
  $dc.Child = $ds
