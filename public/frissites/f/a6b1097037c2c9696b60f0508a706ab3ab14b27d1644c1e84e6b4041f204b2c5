# ---------- Munkanapló: a kipipált teendő bekerül a BREMAT Munkanaplóba ----------
# Kipipáláskor egy „Kész: …” bejegyzés megy a mai napra; ha visszaveszed a pipát, törlődik.
# A küldés a háttérben történik (a fül nem akad meg). Ha nincs net, sorban vár
# (%APPDATA%\Teendoim\naplo.json), és percenként újrapróbálja. A belépési kód a
# beallitas.json-ban titkosítva van (Windows-felhasználóhoz kötve).
$naploUrl  = 'https://bremat-stuff.netlify.app/api/naplo'
$naploPage = 'https://bremat-stuff.netlify.app/naplo/'
$naploFile = Join-Path $dir 'naplo.json'
try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch {}
try { [Net.WebRequest]::DefaultWebProxy.Credentials = [Net.CredentialCache]::DefaultNetworkCredentials } catch {}
$script:nHttp = $null
try {
  Add-Type -AssemblyName System.Net.Http
  $script:nHttp = New-Object System.Net.Http.HttpClient
  $script:nHttp.Timeout = [TimeSpan]::FromSeconds(30)
} catch {}

$script:nQueue = New-Object System.Collections.ArrayList   # várakozó műveletek: create / delete
$script:nMap = @{}                                          # teendő id -> napló bejegyzés id
if (Test-Path $naploFile) {
  try {
    $nj = ConvertFrom-Json ([IO.File]::ReadAllText($naploFile, $utf8))
    foreach ($q in @($nj.queue)) { if ($q -and $q.op) { [void]$script:nQueue.Add([pscustomobject]@{ op = [string]$q.op; item = [string]$q.item; date = [string]$q.date; text = [string]$q.text }) } }
    if ($nj.map) { foreach ($p in $nj.map.PSObject.Properties) { $script:nMap[$p.Name] = [string]$p.Value } }
  } catch {}
}
function NaploSave {
  try {
    $json = ConvertTo-Json -InputObject @{ queue = @($script:nQueue); map = $script:nMap } -Depth 4
    [IO.File]::WriteAllText("$naploFile.tmp", $json, $utf8)
    Move-Item "$naploFile.tmp" $naploFile -Force
  } catch {}
}
function NaploLog($msg) { try { [IO.File]::AppendAllText((Join-Path $dir 'hiba.txt'), "$(Get-Date -Format s) Munkanapló: $msg`r`n", $utf8) } catch {} }

$script:nCode = $null
function NaploCode {
  if ($null -ne $script:nCode) { return $script:nCode }
  $script:nCode = ''
  if ($script:set.naploKod) {
    try {
      $ss = ConvertTo-SecureString ([string]$script:set.naploKod)
      $b = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($ss)
      try { $script:nCode = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($b) } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($b) }
    } catch { $script:nCode = '' }
  }
  $script:nCode
}

$script:nReq = $null          # a most futó kérés: @{ task; op }
$script:nNext = [int64]0      # ekkortól szabad újra próbálni
$script:nStatus = ''          # utolsó állapot a menübe

function NaploAdd($it, $force = $false) {
  if (-not $script:set.naplo -and -not $force) { return }
  # Utólagos beküldésnél a kipipálás napjára kerül, egyébként a mai napra
  $date = $(if ($force -and $it.doneAt) { [DateTimeOffset]::FromUnixTimeMilliseconds([int64]$it.doneAt).LocalDateTime.ToString('yyyy-MM-dd') } else { TodayKey })
  $t = "Kész: $($it.text)"
  if ([int64]$it.spent -ge 60000) { $t += " (összesen $(FmtDur ([int64]$it.spent)))" }
  if ($it.notes -and $it.notes.Trim()) { $t += "`n" + $it.notes.Trim() }
  if ($t.Length -gt 3900) { $t = $t.Substring(0, 3900) + '…' }
  [void]$script:nQueue.Add([pscustomobject]@{ op = 'create'; item = [string]$it.id; date = $date; text = $t })
  $script:nNext = 0
  NaploSave
}
function NaploUndo($it) {
  $id = [string]$it.id
  # Ha még el sem ment, elég kivenni a sorból
  for ($i = $script:nQueue.Count - 1; $i -ge 0; $i--) {
    $q = $script:nQueue[$i]
    if ($q.op -eq 'create' -and $q.item -eq $id -and -not ($script:nReq -and $script:nReq.op -eq $q)) { $script:nQueue.RemoveAt($i); NaploSave; return }
  }
  $inFlight = $script:nReq -and $script:nReq.op.op -eq 'create' -and $script:nReq.op.item -eq $id
  if ($script:nMap.ContainsKey($id) -or $inFlight) {
    [void]$script:nQueue.Add([pscustomobject]@{ op = 'delete'; item = $id; date = ''; text = '' })
    $script:nNext = 0
    NaploSave
  }
}

# A Teendőim állapota a Központ szigetéhez: hátralévő, fontos, mi fut most
$script:segNext = [int64]0; $script:stNext = [int64]0; $script:stSent = ''
function StatusObj {
  $t = @(Todos)
  $doing = @()
  foreach ($r in @(RunningAll | Sort-Object @{ Expression = { $_.startedAt } })) {
    if ($r.kind -eq 'brk') { continue }
    $doing += @{ text = [string]$r.text; spent_ms = [int64]$r.spent; started_at = $(if ($r.startedAt) { [int64]$r.startedAt } else { $null }) }
  }
  @{ open = @($t | Where-Object { $_.state -ne 'done' }).Count; starred = @($t | Where-Object { $_.star -and $_.state -ne 'done' }).Count; doing = $doing }
}
function StatusSig { ConvertTo-Json -InputObject (StatusObj) -Depth 4 -Compress }

# Tick-ből hívva: egyszerre egy kérés, sorban
function NaploPump {
  if ($script:nReq) {
    if (-not $script:nReq.task.IsCompleted) { return }
    $r = $script:nReq; $script:nReq = $null
    NaploDone $r
  }
  if (-not $script:nHttp -or (NowMs) -lt $script:nNext) { return }
  $now = NowMs
  $timeDue = $script:set.naplo -and $script:segDirty.Count -and $now -ge $script:segNext
  $stDue = $false
  if ($script:set.naplo -and $now -ge $script:stNext) {
    # legfeljebb 3 mp-enként néz rá, és csak akkor küld, ha változott
    if ((StatusSig) -ne $script:stSent) { $stDue = $true } else { $script:stNext = $now + 3000 }
  }
  if (-not $script:nQueue.Count -and -not $timeDue -and -not $stDue) { return }
  $code = NaploCode
  if (-not $code) { $script:nStatus = 'Nincs megadva a belépési kód.'; return }
  $name = $(if ($script:set.naploNev) { [string]$script:set.naploNev } else { [string]$env:USERNAME })
  if (-not $script:nQueue.Count) {
    if ($timeDue) {
      # A legrégebbi elküldetlen nap, egészben (a szerver felülírja)
      $d = @($script:segDirty.Keys | Sort-Object)[0]
      $segs = @(); if ($script:seg[$d]) { foreach ($x in $script:seg[$d]) { $segs += @{ name = $x.name; kind = $x.kind; start = [int64]$x.start; end = $x.end } } }
      $body = @{ action = 'time_day_set'; code = $code; name = $name; day = @{ date = $d; segments = $segs } }
      $op = [pscustomobject]@{ op = 'time'; date = $d; gen = [int]$script:segDirty[$d] }
      $script:segNext = $now + 5000
    } else {
      $sig = StatusSig
      $body = @{ action = 'todo_status_set'; code = $code; name = $name; status = (StatusObj) }
      $op = [pscustomobject]@{ op = 'status'; sig = $sig }
      $script:stNext = $now + 3000
    }
    try {
      $content = New-Object System.Net.Http.StringContent((ConvertTo-Json -InputObject $body -Depth 6 -Compress), [Text.Encoding]::UTF8, 'application/json')
      $script:nReq = @{ task = $script:nHttp.PostAsync($naploUrl, $content); op = $op }
    } catch { $script:nNext = (NowMs) + 60000; $script:nStatus = "Nem sikerült elküldeni: $($_.Exception.Message)" }
    return
  }
  $op = $script:nQueue[0]
  if ($op.op -eq 'create') {
    $body = @{ action = 'create'; code = $code; name = $name; entry = @{ date = $op.date; text = $op.text } }
  } else {
    if (-not $script:nMap.ContainsKey($op.item)) { $script:nQueue.RemoveAt(0); NaploSave; return }
    $body = @{ action = 'delete'; code = $code; name = $name; id = $script:nMap[$op.item] }
  }
  try {
    $content = New-Object System.Net.Http.StringContent((ConvertTo-Json -InputObject $body -Depth 4 -Compress), [Text.Encoding]::UTF8, 'application/json')
    $script:nReq = @{ task = $script:nHttp.PostAsync($naploUrl, $content); op = $op }
  } catch { $script:nNext = (NowMs) + 60000; $script:nStatus = "Nem sikerült elküldeni: $($_.Exception.Message)" }
}
function NaploDone($r) {
  $t = $r.task; $op = $r.op
  if ($t.IsFaulted -or $t.IsCanceled) {
    $script:nNext = (NowMs) + 60000; $script:nStatus = 'Nincs kapcsolat a naplóval – percenként újrapróbálom.'; return
  }
  $res = $t.Result
  $status = [int]$res.StatusCode
  $data = $null
  try { $data = ConvertFrom-Json ($res.Content.ReadAsStringAsync().Result) } catch {}
  $err = $(if ($data -and $data.error) { [string]$data.error } else { '' })
  if ($op.op -eq 'time' -or $op.op -eq 'status') {
    if ($status -eq 200 -or ($status -ge 400 -and $status -lt 500 -and $status -notin 401, 408, 429 -and $err)) {
      if ($status -ne 200) { NaploLog "$($op.op) $($op.date) – elutasítva: $err" }
      if ($op.op -eq 'time') { if ([int]$script:segDirty[$op.date] -eq [int]$op.gen) { $script:segDirty.Remove($op.date) }; SegSave }
      else { $script:stSent = $op.sig }
      if ($status -eq 200 -and -not $script:nQueue.Count) { $script:nStatus = 'Minden elküldve.' }
    } elseif ($status -eq 401 -and $err) {
      $script:set.naploKod = ''; $script:nCode = $null; SaveSet
      $script:nStatus = 'Hibás a belépési kód – add meg újra (menü → Munkanapló).'
    } else {
      $script:nNext = (NowMs) + 60000
      $script:nStatus = "A napló most nem érhető el ($status) – percenként újrapróbálom."
    }
    return
  }
  if ($status -eq 200) {
    if ($op.op -eq 'create' -and $data.data.id) { $script:nMap[$op.item] = [string]$data.data.id }
    if ($op.op -eq 'delete') { $script:nMap.Remove($op.item) }
    $script:nQueue.Remove($op); NaploSave
    $script:nStatus = 'Minden elküldve.'
  } elseif ($status -eq 401 -and $err) {
    # Rossz kód: amíg újat nem adsz meg, nem próbálkozik (a sor megmarad)
    $script:set.naploKod = ''; $script:nCode = $null; SaveSet
    $script:nStatus = 'Hibás a belépési kód – add meg újra (menü → Munkanapló).'
  } elseif ($status -eq 404 -and $op.op -eq 'delete') {
    $script:nMap.Remove($op.item); $script:nQueue.Remove($op); NaploSave
    $script:nStatus = 'Minden elküldve.'
  } elseif ($status -ge 400 -and $status -lt 500 -and $status -ne 401 -and $status -ne 408 -and $status -ne 429 -and $err) {
    # A szerver elutasította (pl. hibás adat): kihagyjuk, hogy ne akassza meg a többit
    NaploLog "$($op.op) – $($op.date) – elutasítva: $err"
    $script:nQueue.Remove($op); NaploSave
    $script:nStatus = "Egy bejegyzést a napló nem fogadott el: $err"
  } else {
    $script:nNext = (NowMs) + 60000
    $script:nStatus = $(if ($status -eq 401) { 'A napló oldala nem nyilvános (Netlify: Make public) – percenként újrapróbálom.' } else { "A napló most nem érhető el ($status) – percenként újrapróbálom." })
  }
}

function NaploSetup {
  Add-Type -AssemblyName Microsoft.VisualBasic
  $script:modal = $true
  try {
    $name0 = $(if ($script:set.naploNev) { [string]$script:set.naploNev } else { [string]$env:USERNAME })
    $name = [Microsoft.VisualBasic.Interaction]::InputBox('Milyen névvel kerüljenek a bejegyzések a Munkanaplóba?', 'Teendőim – Munkanapló', $name0)
    if (-not $name.Trim()) { return $false }
    $code = [Microsoft.VisualBasic.Interaction]::InputBox("A Munkanapló belépési kódja (ugyanaz, mint a tableten):`n`nTitkosítva mentem ezen a gépen.", 'Teendőim – Munkanapló', '')
    if (-not $code.Trim()) { return $false }
    $script:set.naploNev = $name.Trim()
    $script:set.naploKod = ConvertFrom-SecureString (ConvertTo-SecureString $code.Trim() -AsPlainText -Force)
    $script:nCode = $null
    $script:set.naplo = $true
    SaveSet
    # Próba: jó-e a kód (ha nincs net, nem baj – később küldi)
    $msg = 'Bekapcsolva. A kipipált teendők és a napi idősáv (mettől meddig mi ment) mostantól bekerülnek a Munkanaplóba.'
    try {
      $resp = Invoke-WebRequest -Uri $naploUrl -Method Post -UseBasicParsing -TimeoutSec 15 -ContentType 'application/json; charset=utf-8' `
        -Body ([Text.Encoding]::UTF8.GetBytes((ConvertTo-Json -InputObject @{ action = 'ping'; code = $code.Trim() } -Compress)))
      $script:nStatus = 'Kapcsolat rendben.'
    } catch {
      $e = $_; $st = 0; $txt = "$($e.ErrorDetails.Message)"
      try { $st = [int]$e.Exception.Response.StatusCode } catch {}
      if (-not $txt) { try { $txt = (New-Object IO.StreamReader($e.Exception.Response.GetResponseStream())).ReadToEnd() } catch {} }
      if ($st -eq 401 -and $txt -match 'Hibás') {
        $script:set.naploKod = ''; $script:nCode = $null; SaveSet
        $msg = 'Hibás a belépési kód. Próbáld újra: menü → Munkanapló → Név és belépési kód.'
      } elseif ($st -eq 401) {
        $msg = "A kódot elmentettem, de a napló oldala most nem nyilvános (Netlify → Make public).`nAddig a kipipált teendők itt várnak, és magától elküldi őket, amint lehet."
      } else {
        $msg = "A kódot elmentettem, de most nem értem el a naplót.`nA kipipált teendők itt várnak, és magától elküldi őket, amint van kapcsolat."
      }
    }
    $script:nNext = 0
    [System.Windows.MessageBox]::Show($win, $msg, 'Teendőim – Munkanapló') | Out-Null
    return $true
  } finally { $script:modal = $false }
}
# A korábban (a naplózás előtt) kipipált teendők egyszeri beküldése
function NaploBackfill {
  $have = @{}
  foreach ($q in $script:nQueue) { if ($q.op -eq 'create') { $have[[string]$q.item] = $true } }
  $todo = @($script:items | Where-Object { $_.state -eq 'done' -and -not $script:nMap.ContainsKey([string]$_.id) -and -not $have.ContainsKey([string]$_.id) } | Sort-Object @{ Expression = { $_.doneAt } })
  if (-not $todo.Count) { Ask 'Minden kész teendő benne van már a naplóban (vagy épp küldésre vár).'; return }
  if (-not (NaploCode)) { if (-not (NaploSetup)) { return } }
  $script:modal = $true
  try {
    $ans = [System.Windows.MessageBox]::Show($win, "$($todo.Count) kész teendő még nincs a naplóban.`n`nBeküldjem őket? Mindegyik arra a napra kerül, amikor kipipáltad.", 'Teendőim – Munkanapló', 'YesNo')
  } finally { $script:modal = $false }
  if ($ans -ne 'Yes') { return }
  foreach ($x in $todo) { NaploAdd $x $true }
  $script:nNext = 0
  Ask "$($todo.Count) teendő küldésre vár – pár másodperc múlva a naplóban lesznek."
}
function NaploToggle {
  if ($script:set.naplo) { $script:set.naplo = $false; SaveSet; return }
  if (-not (NaploCode)) { [void](NaploSetup); return }
  $script:set.naplo = $true; $script:nNext = 0; SaveSet
}

# ---------- Menü ----------
$lnkPath = Join-Path ([Environment]::GetFolderPath('Startup')) 'Teendoim.lnk'
function MakeShortcut {
  $sh = New-Object -ComObject WScript.Shell
  $l = $sh.CreateShortcut($lnkPath)
  $l.TargetPath = Join-Path $PSHOME 'powershell.exe'
  $l.Arguments = "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$PSCommandPath`""
  $l.WorkingDirectory = Split-Path $PSCommandPath
  $l.WindowStyle = 7; $l.Description = 'Teendőim'
  $l.Save()
}
function ToggleAutostart {
  $script:set.autostart = -not $script:set.autostart; SaveSet
  try {
    if ($script:set.autostart) { MakeShortcut } elseif (Test-Path $lnkPath) { Remove-Item $lnkPath -Force }
  } catch { Fail "Az automatikus indítást nem sikerült beállítani: $_" }
}
function Ask($text) {
  $script:modal = $true
  try { [System.Windows.MessageBox]::Show($win, $text, 'Teendőim') | Out-Null } finally { $script:modal = $false }
}
function ImportClip {
  $txt = [Windows.Clipboard]::GetText()
  try { $parsed = ConvertFrom-Json $txt } catch { $parsed = $null }
  $n = 0
  foreach ($d in @($parsed)) {
    if ($d -and $d.text -and -not ($d.id -and (FindItem $d.id))) {
      $x = Norm $d; $x.order = OrderEdge $true
      if ($x.state -eq 'doing') { $x.state = 'open'; $x.startedAt = $null }
      [void]$script:items.Add($x); $script:fresh += $x.id; $n++
    }
  }
  if ($n) { Commit; Ask "$n teendő átvéve." } else { Ask "A vágólapon nem találtam teendőlistát.`n`nA böngészős listából így másolod ki: nyisd meg a régi oldalt, nyomd meg az F12-t, a Console fülön írd be:`n`ncopy(localStorage.teendok)`n`nnyomj Entert, aztán itt válaszd újra az Importálást." }
}
function ResetTime {
  foreach ($x in $script:items) { if ($x.state -ne 'done' -and -not (IsAct $x)) { $x.spent = [int64]0; if ($x.startedAt) { $x.startedAt = NowMs } } }
  Commit
}

# ---------- BREMAT Központ helyi része (Valk fájlok) ----------
# A BrematKozpont mappa a Teendoim mappa mellett (vagy benne) van. A Teendőim indításakor
# a háttérben elindítja (ha már fut, nem indul kétszer), a menüből pedig megnyitható.
$kozpontPs = $null
if ($PSCommandPath) {
  $here = Split-Path $PSCommandPath
  foreach ($kpCand in (Join-Path (Split-Path $here) 'BrematKozpont\Kozpont.ps1'), (Join-Path $here 'BrematKozpont\Kozpont.ps1')) {
    if (Test-Path -LiteralPath $kpCand) { $kozpontPs = $kpCand; break }
  }
}
function KozpontStart($browser) {
  if (-not $kozpontPs) {
    [System.Windows.MessageBox]::Show($win, "Nem találom a BrematKozpont mappát.`n`nCsomagold ki a Teendoim mappa mellé (ugyanabba a mappába, ahol a Teendoim van).", 'Teendőim – BREMAT Központ') | Out-Null
    return
  }
  $args2 = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$kozpontPs`""
  if (-not $browser) { $args2 += ' -NoBrowser' }
  try { Start-Process (Join-Path $PSHOME 'powershell.exe') -ArgumentList $args2 -WindowStyle Hidden } catch {}
}

# ---------- Önfrissítés ----------
# A Teendőim (és a mellette lévő BrematKozpont) kódja magától frissül a bremat-stuff oldalról:
# induláskor és 3 óránként megnézi a /frissites/manifest.json-t, és letölti azt, ami változott.
# Csak programkód jön le (SHA-256 ellenőrző összeggel); a Valk fájlok és az adatok a gépen
# maradnak, semmi nem megy fel. A lecserélt fájlok a %APPDATA%\Teendoim\frissites\regi\ alá
# kerülnek; ha az új változat nem indul el, visszaáll a régire, és azt a változatot kihagyja.
$updBase  = 'https://bremat-stuff.netlify.app/frissites/'
$updDir   = Join-Path $dir 'frissites'
$updState = Join-Path $updDir 'allapot.json'
$kpBase   = 'http://localhost:47801/'
$script:upd = @{ phase = 'idle'; next = (NowMs) + 20000; task = $null; man = $null; files = @(); msg = ''; force = $false
                 note = $null; kpCheck = $null; kpEnd = 0; kpTask = $null }
$script:updRestart = $false
$script:kpHttp = $null
try {
  $kpH = New-Object System.Net.Http.HttpClientHandler; $kpH.UseProxy = $false   # a localhost ne menjen proxyn át
  $script:kpHttp = New-Object System.Net.Http.HttpClient($kpH); $script:kpHttp.Timeout = [TimeSpan]::FromSeconds(4)
} catch {}
function UpdLog($m) { try { [IO.File]::AppendAllText((Join-Path $dir 'hiba.txt'), "$(Get-Date -Format s) Frissítés: $m`r`n", $utf8) } catch {} }
function UpdRead { try { if (Test-Path -LiteralPath $updState) { return (ConvertFrom-Json ([IO.File]::ReadAllText($updState, $utf8))) } } catch {}; $null }
function UpdWrite($o) {
  try { New-Item -ItemType Directory -Force -Path $updDir | Out-Null; [IO.File]::WriteAllText($updState, (ConvertTo-Json -InputObject $o -Depth 5), $utf8) } catch { UpdLog "állapot: $_" }
}
function UpdSet($o, $name, $value) { $o | Add-Member -NotePropertyName $name -NotePropertyValue $value -Force }
function Sha($bytes) {
  $h = [Security.Cryptography.SHA256]::Create()
  try { -join ($h.ComputeHash([byte[]]$bytes) | ForEach-Object { $_.ToString('x2') }) } finally { $h.Dispose() }
}
# A manifest útvonala → a helyi fájl ($null, ha az a rész nincs ezen a gépen vagy gyanús az út)
function UpdLocal($p) {
  if ($p -notmatch '^(Teendoim|BrematKozpont)/[A-Za-z0-9][A-Za-z0-9._/-]*$' -or $p -match '\.\.') { return $null }
  $root = $(if ($p.StartsWith('Teendoim/')) { $here } elseif ($kozpontPs) { Split-Path $kozpontPs } else { $null })
  if (-not $root) { return $null }
  Join-Path $root ($p.Substring($p.IndexOf('/') + 1).Replace('/', '\'))
}
function KozpontStop {
  if (-not $script:kpHttp) { return }
  try {
    $rq = New-Object System.Net.Http.HttpRequestMessage([System.Net.Http.HttpMethod]::Post, ($kpBase + 'api/stop'))
    $rq.Headers.Add('X-Helyi', '1')
    $rq.Content = New-Object System.Net.Http.StringContent('{}', [Text.Encoding]::UTF8, 'application/json')
    [void]$script:kpHttp.SendAsync($rq).Result
  } catch {}
  Start-Sleep -Milliseconds 1200   # a szerver elengedi a portot
}
# Visszaállítás a mentésből (csak a megadott előtagú fájlok, pl. 'BrematKozpont/')
function UpdRestore($files, $prefix = '') {
  foreach ($f in @($files)) {
    if (-not $f -or -not ([string]$f.p).StartsWith($prefix)) { continue }
    try {
      if ($f.backup -and (Test-Path -LiteralPath $f.backup)) { Copy-Item -LiteralPath $f.backup -Destination $f.local -Force }
      elseif (-not $f.backup -and (Test-Path -LiteralPath $f.local)) { Remove-Item -LiteralPath $f.local -Force }
    } catch { UpdLog "visszaállítás ($($f.p)): $_" }
  }
}
function UpdPump {
  $u = $script:upd
  if (-not $script:nHttp -or -not $here) { return }
  if ($u.note -and $script:open) { ShowNote $u.note; $u.note = $null }
  # A frissített helyi Központ elindult-e (különben vissza a régire)
  if ($u.kpCheck -and (NowMs) -ge $u.kpCheck -and $script:kpHttp) {
    if (-not $u.kpTask) { $u.kpTask = $script:kpHttp.GetAsync($kpBase) }
    elseif ($u.kpTask.IsCompleted) {
      $t = $u.kpTask; $u.kpTask = $null
      $good = $false; try { $good = -not $t.IsFaulted -and -not $t.IsCanceled -and [int]$t.Result.StatusCode -eq 200 } catch {}
      if ($good) {
        $u.kpCheck = $null; $st = UpdRead
        if ($st) { UpdSet $st 'kozpontOk' $true; UpdSet $st 'phase' 'kesz'; UpdWrite $st }
      } elseif ((NowMs) -ge $u.kpEnd) {
        $u.kpCheck = $null; UpdLog 'a frissített helyi Központ nem indult el, visszaállok a régire'
        $st = UpdRead
        if ($st) { KozpontStop; UpdRestore $st.files 'BrematKozpont/'; UpdSet $st 'bad' $st.version; UpdSet $st 'phase' 'kesz'; UpdWrite $st }
        KozpontStart $false
        $u.note = 'A Valk fájlok frissítése nem sikerült, maradt a régi változat.'
      } else { $u.kpCheck = (NowMs) + 3000 }
    }
  }
  switch ($u.phase) {
    'idle' {
      if ((NowMs) -lt $u.next) { return }
      $u.next = (NowMs) + 3 * 3600000
      $u.task = $script:nHttp.GetStringAsync($updBase + 'manifest.json?t=' + (NowMs)); $u.phase = 'manifest'
    }
    'manifest' {
      if (-not $u.task.IsCompleted) { return }
      $t = $u.task; $u.task = $null; $u.phase = 'idle'
      if ($t.IsFaulted -or $t.IsCanceled) { $u.msg = 'Most nem értem el, később újra megnézem.'; return }
      try { $m = ConvertFrom-Json $t.Result } catch { $u.msg = 'Hibás frissítés-lista.'; return }
      if (-not $m.version -or -not $m.files) { $u.msg = 'Hibás frissítés-lista.'; return }
      $st = UpdRead
      if ($st -and $st.bad -eq $m.version -and -not $u.force) { $u.msg = 'Az utolsó változat nálad nem indult el, kihagytam.'; return }
      $u.force = $false
      $todo = @()
      foreach ($f in @($m.files)) {
        $loc = UpdLocal ([string]$f.p)
        if (-not $loc -or [string]$f.sha256 -notmatch '^[0-9a-f]{64}$' -or [string]$f.u -notmatch '^f/[0-9a-f]{64}$') { continue }
        $cur = ''; try { if ([IO.File]::Exists($loc)) { $cur = Sha ([IO.File]::ReadAllBytes($loc)) } } catch {}
        if ($cur -ne [string]$f.sha256) {
          $todo += [pscustomobject]@{ p = [string]$f.p; sha = [string]$f.sha256; local = $loc; task = $script:nHttp.GetByteArrayAsync($updBase + [string]$f.u); bytes = $null }
        }
      }
      if (-not $todo.Count) { $u.msg = 'Naprakész.'; return }
      $u.man = $m; $u.files = $todo; $u.phase = 'files'
    }
    'files' {
      foreach ($f in $u.files) { if (-not $f.task.IsCompleted) { return } }
      $u.phase = 'idle'
      foreach ($f in $u.files) {
        if ($f.task.IsFaulted -or $f.task.IsCanceled) { $u.msg = 'A letöltés megszakadt, később újra próbálom.'; $u.next = (NowMs) + 600000; return }
        $f.bytes = $f.task.Result
        if ((Sha $f.bytes) -ne $f.sha) { UpdLog "rossz ellenőrző összeg: $($f.p)"; $u.msg = 'A letöltött fájl hibás volt, kihagytam.'; return }
      }
      $u.phase = 'ready'
    }
    'ready' {
      # Ne használat közben cserélje: becsukott panel (vagy 1 perce nem nyúltál a géphez), nincs nyitott ablak, küldés
      $busy = $script:open -and (-not $script:idleOk -or [TeendoimIdle]::IdleMs() -lt 60000)
      if ($busy -or $script:modal -or $script:drag -or $script:editing -or $script:nReq) { return }
      UpdApply
    }
  }
}
function UpdApply {
  $u = $script:upd; $u.phase = 'idle'
  $bdir = Join-Path $updDir 'regi'
  $list = @()
  try {
    if (Test-Path -LiteralPath $bdir) { Remove-Item -LiteralPath $bdir -Recurse -Force }
    foreach ($f in $u.files) {
      $b = Join-Path $bdir ($f.p.Replace('/', '\'))
      $had = [IO.File]::Exists($f.local)
      if ($had) { New-Item -ItemType Directory -Force -Path (Split-Path $b) | Out-Null; Copy-Item -LiteralPath $f.local -Destination $b -Force }
      $list += [pscustomobject]@{ p = $f.p; local = $f.local; backup = $(if ($had) { $b } else { $null }) }
    }
  } catch { UpdLog "a régi változat mentése: $_"; $u.msg = 'Nem tudtam elmenteni a régi változatot, kihagytam.'; return }
  $self = @($u.files | Where-Object { $_.p.StartsWith('Teendoim/') -and $_.p -like '*.ps1' }).Count -gt 0
  $kp = @($u.files | Where-Object { $_.p -eq 'BrematKozpont/Kozpont.ps1' }).Count -gt 0
  $prev = UpdRead
  UpdWrite ([ordered]@{ version = [string]$u.man.version; at = (Get-Date -Format s); phase = 'proba'; files = $list
    teendoim = $(if ($self) { 'var' } else { 'ok' }); kozpont = $kp; kozpontOk = $false; bad = $(if ($prev) { $prev.bad } else { $null }) })
  if ($kp) { KozpontStop }
  try {
    foreach ($f in $u.files) {
      New-Item -ItemType Directory -Force -Path (Split-Path $f.local) | Out-Null
      [IO.File]::WriteAllBytes("$($f.local).uj", [byte[]]$f.bytes)
      Move-Item -LiteralPath "$($f.local).uj" -Destination $f.local -Force
    }
  } catch {
    UpdLog "a fájlok cseréje: $_"; UpdRestore $list
    $st = UpdRead; if ($st) { UpdSet $st 'phase' 'kesz'; UpdWrite $st }
    if ($kp) { KozpontStart $false }
    $u.msg = 'A fájlok cseréje nem sikerült, maradt a régi változat.'; return
  }
  $u.files = @(); $u.msg = 'Frissítve.'
  if ($self) { $script:updRestart = $true; $win.Close(); return }   # a folytatás a program végén
  if ($kp) {
    KozpontStart $false
    $u.kpCheck = (NowMs) + 3000; $u.kpEnd = (NowMs) + 60000
  } else { $st = UpdRead; if ($st) { UpdSet $st 'phase' 'kesz'; UpdWrite $st } }
  $u.note = 'Frissítve: új változat.'
}
# Az új példány indulás után jelzi, hogy rendben elindult (a régi példány erre vár)
function UpdStartup {
  $st = UpdRead; if (-not $st) { return }
  if ($st.phase -eq 'proba') {
    UpdSet $st 'teendoim' 'ok'
    if ($st.kozpont -and -not $st.kozpontOk) { $script:upd.kpCheck = (NowMs) + 3000; $script:upd.kpEnd = (NowMs) + 60000 }
    else { UpdSet $st 'phase' 'kesz' }
    UpdWrite $st
    $script:upd.note = 'Frissítve: új változat.'; $script:upd.msg = 'Frissítve.'
  } elseif ($st.phase -eq 'visszaallitva') {
    UpdSet $st 'phase' 'kesz'; UpdWrite $st
    $script:upd.note = 'A frissítés nem sikerült, maradt a régi változat.'; $script:upd.msg = $script:upd.note
  }
}
# A régi példány (az ablak már bezárult): elindítja az újat, és ha az 60 mp alatt nem jelez, visszaáll
function UpdRelaunch {
  try { $mutex.Dispose() } catch {}
  $ps = Join-Path $PSHOME 'powershell.exe'
  $a = "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$PSCommandPath`" -Frissult"
  $p = $null
  try { $p = Start-Process $ps -ArgumentList $a -WindowStyle Hidden -PassThru } catch { UpdLog "újraindítás: $_" }
  $end = (Get-Date).AddSeconds(60)
  while ($p -and (Get-Date) -lt $end) {
    Start-Sleep -Milliseconds 500
    $st = UpdRead
    if ($st -and $st.teendoim -eq 'ok') { return }
    if ($p.HasExited) { break }
  }
  UpdLog 'az új változat nem indult el, visszaállok a régire'
  try { if ($p -and -not $p.HasExited) { Stop-Process -Id $p.Id -Force } } catch {}
  $st = UpdRead
  if ($st) {
    if ($st.kozpont) { KozpontStop }
    UpdRestore $st.files
    UpdSet $st 'bad' $st.version; UpdSet $st 'phase' 'visszaallitva'; UpdWrite $st
  }
  try { Start-Process $ps -ArgumentList $a -WindowStyle Hidden } catch {}
}

