function Brush($hex) { New-Object Windows.Media.SolidColorBrush ([Windows.Media.ColorConverter]::ConvertFromString($hex)) }

# ---------- Idő ----------
function NowMs { [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() }
function NewId { "$(NowMs)-" + [Guid]::NewGuid().ToString('N').Substring(0, 4) }
function TodayKey { Get-Date -Format 'yyyy-MM-dd' }
function Midnight { ([DateTimeOffset]::new([DateTime]::Today)).ToUnixTimeMilliseconds() }
function FmtLive($ms) {
  $s = [int64][Math]::Floor($ms / 1000); $h = [Math]::Floor($s / 3600); $m = [Math]::Floor(($s % 3600) / 60); $sec = $s % 60
  if ($h -gt 0) { '{0}:{1:00}:{2:00}' -f $h, $m, $sec } else { '{0}:{1:00}' -f $m, $sec }
}
function FmtDur($ms) {
  $min = [int64][Math]::Floor($ms / 60000)
  if ($min -lt 1) { return '<1 p' }
  $h = [Math]::Floor($min / 60); $m = $min % 60
  if ($h -gt 0) { if ($m) { "$h ó $m p" } else { "$h ó" } } else { "$m p" }
}

# ---------- Adatok ----------
function Norm($d) {
  $st = [string]$d.state
  if ($st -notin 'open', 'doing', 'done') { $st = 'open' }
  [pscustomobject]@{
    id        = $(if ($d.id) { [string]$d.id } else { NewId })
    text      = [string]$d.text
    state     = $st
    star      = [bool]$d.star
    created   = $(if ($d.created) { [int64]$d.created } else { NowMs })
    doneAt    = $(if ($d.doneAt) { [int64]$d.doneAt } else { $null })
    order     = $(if ($null -ne $d.order) { [double]$d.order } else { $null })
    spent     = $(if ($d.spent) { [int64]$d.spent } else { [int64]0 })
    startedAt = $(if ($d.startedAt) { [int64]$d.startedAt } else { $null })
    notes     = $(if ($d.notes) { [string]$d.notes } else { '' })
    # '' = teendő; 'act' = állandó tevékenység (pl. Általános), 'brk' = szünet – ezek sosem lesznek „kész”
    kind      = $(if ([string]$d.kind -in 'act', 'brk') { [string]$d.kind } else { '' })
  }
}

$script:items = New-Object System.Collections.ArrayList
if (Test-Path $dataFile) {
  try {
    $raw = [IO.File]::ReadAllText($dataFile, $utf8)
    if ($raw.Trim()) { $parsed = ConvertFrom-Json $raw; foreach ($d in $parsed) { [void]$script:items.Add((Norm $d)) } }
  } catch {
    Copy-Item $dataFile "$dataFile.hibas" -Force
    Fail "A teendők fájlja nem olvasható, félretettem: $dataFile.hibas"
  }
}
# A régi (sorrend nélküli) listák a korábbi megjelenés szerinti sorrendet kapják
if (@($script:items | Where-Object { $null -eq $_.order }).Count) {
  $i = 0
  foreach ($it in @($script:items | Sort-Object @{ Expression = { if ($_.state -eq 'doing') { 0 } elseif ($_.star) { 1 } else { 2 } } }, @{ Expression = { $_.created } })) { $it.order = [double]$i; $i++ }
}
function OrderEdge($max) {
  $o = @($script:items | ForEach-Object { $_.order } | Where-Object { $null -ne $_ })
  if (-not $o.Count) { return 0.0 }
  $m = $o | Measure-Object -Maximum -Minimum
  if ($max) { $m.Maximum + 1 } else { $m.Minimum - 1 }
}
function SaveData {
  try {
    $json = ConvertTo-Json -InputObject @($script:items) -Depth 3
    [IO.File]::WriteAllText("$dataFile.tmp", $json, $utf8)
    Move-Item "$dataFile.tmp" $dataFile -Force
  } catch { Fail "Nem sikerült menteni: $_" }
}

$script:set = @{ x = $null; y = $null; pinned = $false; showDone = $false; autostart = $true; today = ''; todayMs = 0; lastSeen = $null; idleMin = 2; naplo = $false; naploNev = ''; naploKod = ''; single = $true; actsInit = $false }
if (Test-Path $setFile) {
  try {
    $s = ConvertFrom-Json ([IO.File]::ReadAllText($setFile, $utf8))
    foreach ($k in @($script:set.Keys)) { if ($null -ne $s.$k) { $script:set[$k] = $s.$k } }
  } catch {}
}
function SaveSet { try { [IO.File]::WriteAllText($setFile, (ConvertTo-Json $script:set), $utf8) } catch {} }

# Első indításkor két állandó tevékenység: „Általános” (ami nem fér bele egy konkrét teendőbe) és „Szünet”
if (-not $script:set.actsInit) {
  [void]$script:items.Add((Norm @{ text = 'Általános'; kind = 'act'; order = -1000 }))
  [void]$script:items.Add((Norm @{ text = 'Szünet'; kind = 'brk'; order = -999 }))
  $script:set.actsInit = $true; SaveSet
}
function IsAct($it) { $it.kind -eq 'act' -or $it.kind -eq 'brk' }
function Todos { foreach ($i in $script:items) { if (-not (IsAct $i)) { $i } } }

# ---------- Napi idősáv: mettől meddig mi ment ----------
# Minden indítás / váltás / megállás egy szakasz: { item, name, kind, start, end } (end = $null, amíg fut).
# Napokra bontva az ido.json-ban (az utolsó 21 nap), és ha a Munkanapló be van kapcsolva,
# a megváltozott napot egészben elküldi (time_day_set) – a napló heti nézetében idősáv lesz belőle.
$segFile = Join-Path $dir 'ido.json'
$script:seg = @{}        # 'yyyy-MM-dd' -> ArrayList
$script:segDirty = @{}   # 'yyyy-MM-dd' -> változásszámláló (ami még nincs elküldve)
if (Test-Path $segFile) {
  try {
    $sj = ConvertFrom-Json ([IO.File]::ReadAllText($segFile, $utf8))
    if ($sj.days) {
      foreach ($p in $sj.days.PSObject.Properties) {
        $l = New-Object System.Collections.ArrayList
        foreach ($x in @($p.Value)) { if ($x -and $x.start) {
          [void]$l.Add([pscustomobject]@{ item = [string]$x.item; name = [string]$x.name; kind = [string]$x.kind; start = [int64]$x.start; end = $(if ($null -ne $x.end) { [int64]$x.end } else { $null }) }) } }
        $script:seg[$p.Name] = $l
      }
    }
    foreach ($d in @($sj.dirty)) { if ($d) { $script:segDirty[[string]$d] = 1 } }
  } catch { Copy-Item $segFile "$segFile.hibas" -Force }
}
function DayOf($ms) { [DateTimeOffset]::FromUnixTimeMilliseconds([int64]$ms).LocalDateTime.ToString('yyyy-MM-dd') }
function SegSave {
  try {
    $old = (Get-Date).AddDays(-21).ToString('yyyy-MM-dd')
    foreach ($k in @($script:seg.Keys)) { if ($k -lt $old) { $script:seg.Remove($k); $script:segDirty.Remove($k) } }
    $days = @{}; foreach ($k in $script:seg.Keys) { $days[$k] = @($script:seg[$k]) }
    $json = ConvertTo-Json -InputObject @{ days = $days; dirty = @($script:segDirty.Keys) } -Depth 5
    [IO.File]::WriteAllText("$segFile.tmp", $json, $utf8)
    Move-Item "$segFile.tmp" $segFile -Force
  } catch {}
}
function SegTouch($d) { $script:segDirty[$d] = 1 + [int]$script:segDirty[$d] }
function SegAdd($item, $name, $kind, $start, $end) {
  $d = DayOf $start
  if (-not $script:seg.ContainsKey($d)) { $script:seg[$d] = New-Object System.Collections.ArrayList }
  [void]$script:seg[$d].Add([pscustomobject]@{ item = [string]$item; name = [string]$name; kind = $kind; start = [int64]$start; end = $end })
  SegTouch $d; SegSave
}
function SegKind($it) { if ($it.kind -eq 'brk') { 'break' } elseif ($it.kind -eq 'act') { 'activity' } else { 'todo' } }
function SegOpen($it, $at) { SegAdd $it.id $it.text (SegKind $it) $at $null }
function SegClose($it, $at) {
  $hit = $false
  foreach ($d in @($script:seg.Keys)) {
    foreach ($x in $script:seg[$d]) {
      if ($x.item -eq [string]$it.id -and $null -eq $x.end) { $x.end = [int64][Math]::Max([int64]$at, [int64]$x.start); SegTouch $d; $hit = $true }
    }
  }
  if ($hit) { SegSave }
}
# Egy tétel mai ideje a szakaszokból (a tevékenység-gombokon látszik)
function SegToday($id) {
  $sum = [int64]0; $now = NowMs
  $l = $script:seg[(TodayKey)]
  if ($l) { foreach ($x in $l) { if ($x.item -eq [string]$id) { $sum += $(if ($null -ne $x.end) { [int64]$x.end } else { $now }) - [int64]$x.start } } }
  $sum
}

# ---------- Időmérés ----------
function FindItem($id) { foreach ($i in $script:items) { if ($i.id -eq $id) { return $i } } }
function RemoveItem($id) { for ($i = 0; $i -lt $script:items.Count; $i++) { if ($script:items[$i].id -eq $id) { $script:items.RemoveAt($i); return } } }
function RunningAll { foreach ($i in $script:items) { if ($i.state -eq 'doing') { $i } } }
function Elapsed($it) { [int64]$it.spent + $(if ($it.state -eq 'doing' -and $it.startedAt) { (NowMs) - [int64]$it.startedAt } else { 0 }) }
function TodayMs {
  $base = $(if ($script:set.today -eq (TodayKey)) { [int64]$script:set.todayMs } else { 0 })
  foreach ($r in @(RunningAll)) { if ($r.startedAt -and $r.kind -ne 'brk') { $base += [Math]::Max(0, (NowMs) - [Math]::Max([int64]$r.startedAt, (Midnight))) } }
  $base
}
# A futó óra leállítása: az eltelt idő hozzáadódik a teendőhöz és a mai összeshez
function StopRun($it, $until = $null) {
  if ($it.state -eq 'doing' -and $it.startedAt) {
    $now = $(if ($null -ne $until) { [Math]::Max([int64]$until, [int64]$it.startedAt) } else { NowMs })
    $it.spent = [int64]$it.spent + ($now - [int64]$it.startedAt)
    if ($script:set.today -ne (TodayKey)) { $script:set.today = TodayKey; $script:set.todayMs = 0 }
    # a szünet nem számít bele a mai munkaidőbe
    if ($it.kind -ne 'brk') { $script:set.todayMs = [int64]$script:set.todayMs + [Math]::Max(0, $now - [Math]::Max([int64]$it.startedAt, (Midnight))) }
    SaveSet
    SegClose $it $now
  }
  $it.startedAt = $null
}
# Váltás: alapból egyszerre egy óra fut – egy másik indítása megállítja az előzőt.
# (A menüben kikapcsolható; akkor több is futhat, mindegyik a saját idejét gyűjti.)
function StartRun($it, $at = $null) {
  if ($script:set.single) {
    foreach ($r in @(RunningAll)) { if ($r.id -ne $it.id) { StopRun $r; $r.state = 'open'; $script:fresh += $r.id } }
  }
  if ($it.state -eq 'doing' -and $it.startedAt) { return }
  $t = $(if ($null -ne $at) { [int64]$at } else { NowMs })
  $it.state = 'doing'; $it.startedAt = $t
  SegOpen $it $t
}

# Indításkor: ha a program nem futott (pl. leállt a gép), csak az utolsó életjelig számolunk, és a teendő szünetel
$now0 = NowMs
foreach ($it in @(RunningAll)) {
  if (-not $it.startedAt) { $it.startedAt = $now0; SegOpen $it $now0 }
  elseif ($script:set.lastSeen -and ($now0 - [int64]$script:set.lastSeen) -gt 120000) {
    $end = [Math]::Max([int64]$it.startedAt, [int64]$script:set.lastSeen)
    $it.spent = [int64]$it.spent + ($end - [int64]$it.startedAt)
    SegClose $it $end
    $it.startedAt = $null; $it.state = 'open'
  }
}

# Nyitva maradt szakasz, aminek a tétele már nem fut (pl. összeomlás): az utolsó életjelnél lezárjuk
$runIds = @(RunningAll | ForEach-Object { [string]$_.id })
foreach ($d in @($script:seg.Keys)) { foreach ($x in $script:seg[$d]) {
  if ($null -eq $x.end -and $runIds -notcontains $x.item) {
    $x.end = [int64][Math]::Max([int64]$x.start, $(if ($script:set.lastSeen) { [int64]$script:set.lastSeen } else { [int64]$x.start })); SegTouch $d } } }
SegSave

