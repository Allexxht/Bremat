$script:drag = $null
function DragStart($grip, $e) {
  $row = $grip.Tag
  $kids = @($U.List.Children)
  $idx = [array]::IndexOf($kids, $row)
  if ($idx -lt 0) { return }
  $mids = @()
  foreach ($k in $kids) {
    $k.RenderTransform.BeginAnimation($TY, $null); $k.RenderTransform.Y = 0
    $mids += $k.TranslatePoint([Windows.Point]::new(0, 0), $U.List).Y + $k.ActualHeight / 2
  }
  $script:drag = @{ row = $row; grip = $grip; idx = $idx; target = $idx; kids = $kids; mids = $mids
                    y0 = $e.GetPosition($U.List).Y; h = $row.ActualHeight + 2; active = $false; shifts = @{} }
  [void]$grip.CaptureMouse()
}
function ReDrag($e) {
  $d = $script:drag
  if (-not $d) { return }
  $dy = $e.GetPosition($U.List).Y - $d.y0
  if (-not $d.active) {
    if ([Math]::Abs($dy) -lt 4) { return }
    $d.active = $true
    [Windows.Controls.Panel]::SetZIndex($d.row, 10)
    $d.row.Background = Brush $C.bg; $d.row.Opacity = 0.97
    $fx = New-Object Windows.Media.Effects.DropShadowEffect; $fx.BlurRadius = 16; $fx.ShadowDepth = 3; $fx.Opacity = 0.3
    $d.row.Effect = $fx
  }
  $d.row.RenderTransform.Y = $dy
  $c = $d.mids[$d.idx] + $dy
  $t = 0
  for ($i = 0; $i -lt $d.kids.Count; $i++) { if ($i -ne $d.idx -and $d.mids[$i] -lt $c) { $t++ } }
  $d.target = $t
  for ($i = 0; $i -lt $d.kids.Count; $i++) {
    if ($i -eq $d.idx) { continue }
    $sh = 0
    if ($d.idx -lt $t -and $i -gt $d.idx -and $i -le $t) { $sh = -$d.h }
    elseif ($d.idx -gt $t -and $i -ge $t -and $i -lt $d.idx) { $sh = $d.h }
    if ($d.shifts[$i] -ne $sh) { $d.shifts[$i] = $sh; Anim $d.kids[$i].RenderTransform $TY $null $sh 160 }
  }
  $sy = $e.GetPosition($U.Scroll).Y
  if ($sy -lt 24) { $U.Scroll.ScrollToVerticalOffset($U.Scroll.VerticalOffset - 8) }
  elseif ($sy -gt $U.Scroll.ActualHeight - 24) { $U.Scroll.ScrollToVerticalOffset($U.Scroll.VerticalOffset + 8) }
}
function DragEnd {
  $d = $script:drag
  if (-not $d) { return }
  $script:drag = $null
  try { $d.grip.ReleaseMouseCapture() } catch {}
  if (-not $d.active) { return }
  if ($d.target -eq $d.idx) { Render; return }
  $ids = @($d.kids | ForEach-Object { $_.Tag })
  $moved = $ids[$d.idx]
  $rest = @($ids | Where-Object { $_ -ne $moved })
  $new = @()
  for ($i = 0; $i -lt $rest.Count; $i++) { if ($i -eq $d.target) { $new += $moved }; $new += $rest[$i] }
  if ($d.target -ge $rest.Count) { $new += $moved }
  $o = 0
  foreach ($id in $new) { $x = FindItem $id; if ($x) { $x.order = [double]$o }; $o++ }
  Commit
}

