          <Border x:Name="Undo" Background="{{toast}}" CornerRadius="10" Padding="12,6,6,6" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="UndoText" Foreground="{{toastFg}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Border x:Name="UndoBtn" Grid.Column="1" BorderBrush="{{toastFg}}" BorderThickness="1" CornerRadius="7"
                      Padding="10,3" Margin="8,0,0,0" Cursor="Hand">
                <TextBlock Text="Visszavonás" Foreground="{{toastFg}}" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
        <Canvas x:Name="Fx" IsHitTestVisible="False"/>
      </Grid>
    </Border>
  </Grid>
</Window>
'@
foreach ($k in $C.Keys) { $xaml = $xaml.Replace("{{$k}}", $C[$k]) }

try { $win = [Windows.Markup.XamlReader]::Parse($xaml) } catch { Fail "A felület nem töltődött be: $_"; exit }
$U = @{}
foreach ($n in 'Tab', 'TabStop', 'TabRing', 'TabDot', 'Badge', 'BadgeText', 'TabTimer', 'TabTimerText', 'Chevron', 'Panel', 'Head', 'DateText',
               'PinBtn', 'PinIcon', 'MenuBtn', 'Focus', 'FocusDot', 'FocusLabel', 'RunList', 'Away', 'AwayTitle', 'AwaySub', 'AwayGo', 'AwayCount', 'AwayKeep', 'Count', 'TodayText', 'Body', 'FocusBody', 'Track', 'Fill', 'Cheer', 'InputBox', 'Input', 'Ph', 'AddBtn', 'Scroll', 'List',
               'Empty', 'DoneHead', 'DoneArrow', 'DoneHeadText', 'DoneList', 'Undo', 'UndoText', 'UndoBtn', 'Fx', 'ActsHead', 'Acts') { $U[$n] = $win.FindName($n) }

# ---------- Animáció ----------
$OP = [Windows.UIElement]::OpacityProperty
$SX = [Windows.Media.ScaleTransform]::ScaleXProperty
$SY = [Windows.Media.ScaleTransform]::ScaleYProperty
$TX = [Windows.Media.TranslateTransform]::XProperty
$TY = [Windows.Media.TranslateTransform]::YProperty
$ANG = [Windows.Media.RotateTransform]::AngleProperty
$WP = [Windows.FrameworkElement]::WidthProperty
$CL = [Windows.Controls.Canvas]::LeftProperty
$CT = [Windows.Controls.Canvas]::TopProperty
$easeOut = New-Object Windows.Media.Animation.QuinticEase; $easeOut.EasingMode = 'EaseOut'
$easeIO  = New-Object Windows.Media.Animation.SineEase; $easeIO.EasingMode = 'EaseInOut'
$easeIn  = New-Object Windows.Media.Animation.CubicEase; $easeIn.EasingMode = 'EaseIn'
$backOut = New-Object Windows.Media.Animation.BackEase; $backOut.EasingMode = 'EaseOut'; $backOut.Amplitude = 0.35

function Anim($target, $prop, $from, $to, $ms, $ease = $easeOut, $delay = 0) {
  $a = New-Object Windows.Media.Animation.DoubleAnimation
  if ($null -ne $from) { $a.From = $from }
  $a.To = $to
  $a.Duration = New-Object Windows.Duration ([TimeSpan]::FromMilliseconds($ms))
  if ($ease) { $a.EasingFunction = $ease }
  if ($delay) { $a.BeginTime = [TimeSpan]::FromMilliseconds($delay) }
  $target.BeginAnimation($prop, $a)
}
function Forever($target, $prop, $from, $to, $ms, $reverse = $true, $ease = $null) {
  $a = New-Object Windows.Media.Animation.DoubleAnimation
  if ($ease) { $a.EasingFunction = $ease }
  $a.From = $from; $a.To = $to; $a.AutoReverse = $reverse
  $a.Duration = New-Object Windows.Duration ([TimeSpan]::FromMilliseconds($ms))
  $a.RepeatBehavior = [Windows.Media.Animation.RepeatBehavior]::Forever
  $target.BeginAnimation($prop, $a)
}
function Pop($scale, $from = 0.6, $ms = 380) { Anim $scale $SX $from 1 $ms $backOut; Anim $scale $SY $from 1 $ms $backOut }
function Pulse($el) { Forever $el $OP 1 0.25 900 $true $easeIO }
# Rámutatásra finoman megnő, elhagyva visszaáll
function Hoverable($el, $to = 1.14) {
  $el.RenderTransformOrigin = [Windows.Point]::new(0.5, 0.5)
  if ($el.RenderTransform -isnot [Windows.Media.ScaleTransform]) { $el.RenderTransform = New-Object Windows.Media.ScaleTransform }
  $el.add_MouseEnter({ param($s, $e) Anim $s.RenderTransform $SX $null 1.14 240; Anim $s.RenderTransform $SY $null 1.14 240 })
  $el.add_MouseLeave({ param($s, $e) Anim $s.RenderTransform $SX $null 1 300; Anim $s.RenderTransform $SY $null 1 300 })
}
# Sor eltüntetése: kicsúszik jobbra, a lista simán összezárul
function RowOut($row, $id, [scriptblock]$then) {
  Anim $row $OP $null 0 260 $easeIn
  Anim $row.RenderTransform $TX $null 48 300 $easeIn
  if ($row.LayoutTransform -is [Windows.Media.ScaleTransform]) { Anim $row.LayoutTransform $SY 1 0 320 $easeIO 130 }
  Later 470 $id $then
}
function Later($ms, $arg, [scriptblock]$do) {
  $t = New-Object Windows.Threading.DispatcherTimer
  $t.Interval = [TimeSpan]::FromMilliseconds($ms)
  $t.Tag = @($do, $arg)
  $t.add_Tick({ param($s, $e) $s.Stop(); & $s.Tag[0] $s.Tag[1] })
  $t.Start()
}
function Burst($from) {
  $p = $from.TranslatePoint([Windows.Point]::new($from.ActualWidth / 2, $from.ActualHeight / 2), $U.Fx)
  $cols = $C.accent, $C.ok, $C.star
  for ($i = 0; $i -lt 16; $i++) {
    $r = New-Object Windows.Shapes.Rectangle
    $r.Width = 6; $r.Height = 6; $r.RadiusX = 1.5; $r.RadiusY = 1.5; $r.Fill = Brush $cols[$i % 3]
    [void]$U.Fx.Children.Add($r)
    $ang = $i / 16 * 2 * [Math]::PI + (Get-Random -Maximum 40) / 100
    $dist = 24 + (Get-Random -Maximum 26)
    $ms = 550 + (Get-Random -Maximum 220)
    Anim $r $CL ($p.X - 3) ($p.X - 3 + [Math]::Cos($ang) * $dist) $ms
    Anim $r $CT ($p.Y - 3) ($p.Y - 3 + [Math]::Sin($ang) * $dist) $ms
    Anim $r $OP 1 0 $ms $easeIn
  }
  Later 900 $null { $U.Fx.Children.Clear() }
}

# ---------- Sorok ----------
$ICON = @{
  check = 'M5.5,10.5 L8.5,13.5 L14.5,7'
  play  = 'M7.5,5 L7.5,15 L15,10 Z'
  pause = 'M6.5,5.5 H9 V14.5 H6.5 Z M11,5.5 H13.5 V14.5 H11 Z'
  star  = 'M10,2.8 L12.2,7.4 L17.2,8.1 L13.6,11.6 L14.5,16.6 L10,14.2 L5.5,16.6 L6.4,11.6 L2.8,8.1 L7.8,7.4 Z'
  del   = 'M4,6 H16 M8,6 V4.5 H12 V6 M6,6 L6.7,16 H13.3 L14,6'
  grip  = 'M5,6 L5,6.01 M10,6 L10,6.01 M5,10 L5,10.01 M10,10 L10,10.01 M5,14 L5,14.01 M10,14 L10,14.01'
  clock = 'M10,3.5 A6.5,6.5 0 1,1 9.99,3.5 M10,6.5 V10 L12.5,11.5'
}
function Icon($data, $fill, $stroke, $thick = 1.6, $size = 20) {
  $p = New-Object Windows.Shapes.Path
  $p.Data = [Windows.Media.Geometry]::Parse($data)
  if ($fill) { $p.Fill = $fill }
  if ($stroke) { $p.Stroke = $stroke; $p.StrokeThickness = $thick; $p.StrokeLineJoin = 'Round'; $p.StrokeStartLineCap = 'Round'; $p.StrokeEndLineCap = 'Round' }
  $p.Width = 20; $p.Height = 20; $p.HorizontalAlignment = 'Center'; $p.VerticalAlignment = 'Center'
  if ($size -ne 20) { $p.LayoutTransform = New-Object Windows.Media.ScaleTransform ($size / 20), ($size / 20) }
  $p
}
function Btn($tip, $child, $col) {
  $b = New-Object Windows.Controls.Border
  $b.Style = $win.Resources['Btn']; $b.Child = $child
  $b.VerticalAlignment = 'Center'
  [Windows.Controls.Grid]::SetColumn($b, $col)
  Hoverable $b
  $b
}
function Col($w) { $c = New-Object Windows.Controls.ColumnDefinition; $c.Width = $w; $c }
function Txt($text, $size, $color, $weight = 'Normal') {
  $t = New-Object Windows.Controls.TextBlock
  $t.Text = $text; $t.FontSize = $size; $t.Foreground = Brush $color; $t.FontWeight = [Windows.FontWeights]::$weight; $t.VerticalAlignment = 'Center'
  $t
}
# Kis „címke” a sor alatt: óra ikon + idő
function TimeChip($text, $running) {
  $b = New-Object Windows.Controls.Border
  $b.CornerRadius = 6; $b.Padding = '5,1,7,1'; $b.Margin = '0,0,6,0'
  $b.Background = Brush $(if ($running) { $C.accent } else { $C.surface })
  $fg = $(if ($running) { $C.accentFg } else { $C.muted })
  $sp = New-Object Windows.Controls.StackPanel; $sp.Orientation = 'Horizontal'
  [void]$sp.Children.Add((Icon $ICON.clock $null (Brush $fg) 1.8 12))
  $t = Txt $text 11 $fg $(if ($running) { 'Bold' } else { 'SemiBold' })
  $t.Margin = '3,0,0,0'
  if ($running) { $t.FontFamily = New-Object Windows.Media.FontFamily $C.mono }
  [void]$sp.Children.Add($t)
  $b.Child = $sp
  @($b, $t)
}

$script:fresh = @(); $script:spin = $null; $script:live = @(); $script:stagger = -1

function Fade($brush, $hex, $ms) {
  $a = New-Object Windows.Media.Animation.ColorAnimation
  $a.To = [Windows.Media.ColorConverter]::ConvertFromString($hex)
  $a.Duration = New-Object Windows.Duration ([TimeSpan]::FromMilliseconds($ms)); $a.EasingFunction = $easeOut
  $brush.BeginAnimation([Windows.Media.SolidColorBrush]::ColorProperty, $a)
}
function Row($it) {
  $done = $it.state -eq 'done'
  $row = New-Object Windows.Controls.Border
  $row.Style = $win.Resources['Row']; $row.Tag = $it.id; $row.Margin = '0,1,0,1'
  $bgb = Brush $C.hoverT; $row.Background = $bgb
  $tt = New-Object Windows.Media.TranslateTransform; $row.RenderTransform = $tt
  $g = New-Object Windows.Controls.Grid
  foreach ($w in [Windows.GridLength]::Auto, [Windows.GridLength]::Auto, [Windows.GridLength]::new(1, 'Star'), [Windows.GridLength]::Auto, [Windows.GridLength]::Auto, [Windows.GridLength]::Auto, [Windows.GridLength]::Auto) { [void]$g.ColumnDefinitions.Add((Col $w)) }
  foreach ($h in 1, 2) { $rd = New-Object Windows.Controls.RowDefinition; $rd.Height = [Windows.GridLength]::Auto; [void]$g.RowDefinitions.Add($rd) }
  $row.Child = $g

  # Fogantyú az átrendezéshez
  $grip = New-Object Windows.Controls.Border
  $grip.Width = 18; $grip.Background = [Windows.Media.Brushes]::Transparent; $grip.VerticalAlignment = 'Stretch'
  if (-not $done) {
    $grip.Cursor = [Windows.Input.Cursors]::SizeNS; $grip.Tag = $row
    $grip.Child = Icon $ICON.grip $null (Brush $C.muted) 2.2; $grip.Opacity = 0
    $grip.add_MouseLeftButtonDown({ param($s, $e) $e.Handled = $true; DragStart $s $e })
    $grip.add_MouseMove({ param($s, $e) ReDrag $e })
    $grip.add_MouseLeftButtonUp({ param($s, $e) $e.Handled = $true; DragEnd })
    $grip.add_LostMouseCapture({ DragEnd })
  }
  [void]$g.Children.Add($grip)

  # Kész-karika
  $cg = New-Object Windows.Controls.Grid; $cg.Width = 22; $cg.Height = 22
  $cg.RenderTransformOrigin = [Windows.Point]::new(0.5, 0.5); $cg.RenderTransform = New-Object Windows.Media.ScaleTransform
  $el = New-Object Windows.Shapes.Ellipse; $el.StrokeThickness = 1.8
  $el.Stroke = Brush $(if ($done) { $C.ok } else { $C.muted })
  $el.Fill = $(if ($done) { Brush $C.ok } else { [Windows.Media.Brushes]::Transparent })
  $mark = Icon $ICON.check $null (Brush $C.okFg) 2.3; $mark.Opacity = $(if ($done) { 1 } else { 0 })
  [void]$cg.Children.Add($el); [void]$cg.Children.Add($mark)
  $chk = Btn '' $cg 1
  $chk.Tag = @{ id = $it.id; el = $el; mark = $mark; cg = $cg; row = $row }
  $chk.add_MouseLeftButtonUp({ param($s, $e) $e.Handled = $true; OnCheck $s })
  [void]$g.Children.Add($chk)

  # Címsor: a cím legfeljebb 2 sorban, alatta az eddigi idő; kattintásra lenyílik a részletes leírás
  $hd = New-Object Windows.Controls.Grid; $hd.VerticalAlignment = 'Center'; $hd.Margin = '8,0,4,0'
  $hd.Background = [Windows.Media.Brushes]::Transparent; $hd.Cursor = [Windows.Input.Cursors]::Hand; $hd.Tag = $row
  foreach ($w in [Windows.GridLength]::Auto, [Windows.GridLength]::new(1, 'Star'), [Windows.GridLength]::Auto, [Windows.GridLength]::Auto) { [void]$hd.ColumnDefinitions.Add((Col $w)) }
  [Windows.Controls.Grid]::SetColumn($hd, 2)
  if ($it.star -and -not $done) {
    $sm = Icon $ICON.star (Brush $C.star) (Brush $C.star) 1.4 15
    $sm.Margin = '0,0,6,0'; $sm.VerticalAlignment = 'Top'; $sm.RenderTransformOrigin = [Windows.Point]::new(0.5, 0.5)
    $sst = New-Object Windows.Media.ScaleTransform; $sm.RenderTransform = $sst
    if ($script:spin -eq $it.id) { Pop $sst 0.3 450 }
    $hd.Children.Add($sm) | Out-Null
  }
  $ts = New-Object Windows.Controls.StackPanel; $ts.VerticalAlignment = 'Center'
  [Windows.Controls.Grid]::SetColumn($ts, 1)
  $tb = New-Object Windows.Controls.TextBlock
  $tb.Text = $it.text; $tb.TextWrapping = 'Wrap'; $tb.TextTrimming = 'CharacterEllipsis'; $tb.Tag = $it.id
  $tb.FontSize = 14.5; $tb.LineHeight = 20; $tb.MaxHeight = 40
  $tb.Foreground = Brush $(if ($done) { $C.muted } else { $C.fg })
  if ($it.star -and -not $done) { $tb.FontWeight = [Windows.FontWeights]::SemiBold }
  if ($done) { $tb.TextDecorations = [Windows.TextDecorations]::Strikethrough }
  [void]$ts.Children.Add($tb)
  if ([int64]$it.spent -gt 0) {
    $tl = New-Object Windows.Controls.StackPanel; $tl.Orientation = 'Horizontal'; $tl.Margin = '0,2,0,0'
    [void]$tl.Children.Add((Icon $ICON.clock $null (Brush $C.muted) 1.8 12))
    $tm = Txt (FmtDur ([int64]$it.spent)) 12 $C.muted 'SemiBold'; $tm.Margin = '4,0,0,0'
    [void]$tl.Children.Add($tm)
    [void]$ts.Children.Add($tl)
  }
  [void]$hd.Children.Add($ts)
  if ($it.notes) {
    $ni = Icon 'M5,6 H15 M5,10 H15 M5,14 H11' $null (Brush $C.muted) 1.7 14
    $ni.Margin = '6,0,0,0'; $ni.Opacity = 0.8
    [Windows.Controls.Grid]::SetColumn($ni, 2); [void]$hd.Children.Add($ni)
  }
  $chev = Icon 'M8,5.5 L12.5,10 L8,14.5' $null (Brush $C.muted) 1.9 14
  $chev.Margin = '4,0,2,0'; $chev.RenderTransformOrigin = [Windows.Point]::new(0.5, 0.5); $chev.RenderTransform = New-Object Windows.Media.RotateTransform
  [Windows.Controls.Grid]::SetColumn($chev, 3); [void]$hd.Children.Add($chev)
  $hd.add_MouseLeftButtonDown({ param($s, $e)
    $e.Handled = $true
    if ($e.ClickCount -eq 2) { StartEdit $s.DataContext.title } else { ToggleRow $s.Tag } })
  [void]$g.Children.Add($hd)

  # Lenyíló rész: mit kell pontosan csinálni
  $det = New-Object Windows.Controls.StackPanel; $det.Margin = '8,8,6,2'; $det.Visibility = 'Collapsed'
  $det.LayoutTransform = New-Object Windows.Media.ScaleTransform
  [Windows.Controls.Grid]::SetRow($det, 1); [Windows.Controls.Grid]::SetColumn($det, 2); [Windows.Controls.Grid]::SetColumnSpan($det, 2)
  $nb = New-Object Windows.Controls.Border
  $nb.CornerRadius = 10; $nb.Background = Brush $C.surface; $nb.BorderBrush = Brush $C.line; $nb.BorderThickness = 1
  $ng = New-Object Windows.Controls.Grid
  $box = New-Object Windows.Controls.TextBox
  $box.Text = $it.notes; $box.Tag = $it.id; $box.AcceptsReturn = $true; $box.TextWrapping = 'Wrap'; $box.MinHeight = 64; $box.MaxLength = 4000
  $box.FontSize = 14; $box.Padding = '10,8'; $box.BorderThickness = 0; $box.Background = [Windows.Media.Brushes]::Transparent
  $box.Foreground = Brush $C.fg; $box.CaretBrush = Brush $C.fg; $box.VerticalScrollBarVisibility = 'Auto'; $box.MaxHeight = 220
  $ph = Txt 'Mit kell pontosan csinálni? Írd ide a részleteket…' 13.5 $C.muted
  $ph.Margin = '13,9,8,0'; $ph.VerticalAlignment = 'Top'; $ph.IsHitTestVisible = $false; $ph.TextWrapping = 'Wrap'
  if ($it.notes) { $ph.Visibility = 'Collapsed' }
  $box.DataContext = @{ ph = $ph; frame = $nb }
  $box.add_TextChanged({ param($s, $e)
    $x = FindItem $s.Tag; if ($x) { $x.notes = $s.Text; $script:dirty = $true }
    $s.DataContext.ph.Visibility = $(if ($s.Text) { 'Collapsed' } else { 'Visible' }) })
  $box.add_GotKeyboardFocus({ param($s, $e) $s.DataContext.frame.BorderBrush = Brush $C.accent })
  $box.add_LostKeyboardFocus({ param($s, $e) $s.DataContext.frame.BorderBrush = Brush $C.line; if ($script:dirty) { SaveData; $script:dirty = $false } })
  $box.add_KeyDown({ param($s, $e) if ($e.Key -eq 'Escape') { $e.Handled = $true; [void]$U.Input.Focus() } })
  [void]$ng.Children.Add($box); [void]$ng.Children.Add($ph)
  $nb.Child = $ng
  [void]$det.Children.Add($nb)
  $info = @()
  $days = [int][Math]::Floor(((NowMs) - $it.created) / 86400000)
  $info += 'felvéve ' + ([DateTimeOffset]::FromUnixTimeMilliseconds([int64]$it.created).LocalDateTime.ToString('MMM d., HH:mm', $hu)) + $(if ($days -ge 1) { "  ($days napja)" } else { '' })
  if ([int64]$it.spent -gt 0) { $info += 'eddig ' + (FmtDur ([int64]$it.spent)) }
  if ($done -and $it.doneAt) { $info += 'kész ' + ([DateTimeOffset]::FromUnixTimeMilliseconds([int64]$it.doneAt).LocalDateTime.ToString('MMM d., HH:mm', $hu)) }
  $acts = New-Object Windows.Controls.Grid; $acts.Margin = '0,8,0,0'
