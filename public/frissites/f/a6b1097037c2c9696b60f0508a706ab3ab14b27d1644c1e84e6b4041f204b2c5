          <!-- Tevékenységek: egy kattintás = váltás (ami eddig ment, megáll) -->
          <TextBlock x:Name="ActsHead" Text="MIVEL FOGLALKOZOM" Foreground="{{muted}}" FontSize="11" FontWeight="Bold" Margin="2,14,0,6"/>
          <WrapPanel x:Name="Acts"/>

          <!-- Új teendő -->
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="InputBox" BorderBrush="{{line}}" BorderThickness="1" CornerRadius="10" Background="{{surface}}">
              <Grid>
                <TextBox x:Name="Input" BorderThickness="0" Background="Transparent" Foreground="{{fg}}" CaretBrush="{{fg}}"
                         Padding="10,10" FontSize="14.5" VerticalContentAlignment="Center" MaxLength="300"/>
                <TextBlock x:Name="Ph" Text="Új teendő…" Foreground="{{muted}}" FontSize="14.5" Margin="13,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
